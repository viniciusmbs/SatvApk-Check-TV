  "Viva", "Woohoo", "Canal 131", "Canal 132" // <--- Seus 2 novos canais adicionados aqui
];

async function run() {
  const statuses = {};
  const latencies = {};

  channelsList.forEach((channel) => {
    statuses[channel] = "online";
    latencies[channel] = 180; // latência padrão simulada
  });

  const data = {
    lastUpdate: new Date().toISOString(),
    total: channelsList.length, // Vai calcular 132 automaticamente
    online: channelsList.length,
    offline: 0,
    statuses,
    latencies
  };

  fs.writeFileSync(statusFilePath, JSON.stringify(data, null, 2), 'utf-8');
  console.log(`Sucesso! Arquivo gerado com ${channelsList.length} canais.`);
}

run();