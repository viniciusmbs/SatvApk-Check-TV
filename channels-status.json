  "Animal Planet", "Arte 1", "Curta!", "Discovery Channel", "Discovery H&H", "Discovery Science", 
  "Discovery Theater", "Discovery Turbo", "Discovery World", "Dog TV", "Fish TV", "Food Network", 
  "HGTV", "History 2", "History Channel", "Investigação Discovery", "NatGeo Wild", "National Geographic", 
  "TLC", "Travel Box Brasil", "Band Sports", "Combate", "DAZN", "DAZN 2", "DAZN 3", "DAZN 4", "ESPN", 
  "ESPN 2", "ESPN 3", "ESPN 4", "ESPN 5", "ESPN 6", "Fox Sports", "Fox Sports 2", "Premiere", "Premiere 2", 
  "Premiere 3", "Premiere 4", "Premiere 5", "Premiere 6", "Premiere 7", "Premiere Clubes", "SportTV", 
  "SportTV 2", "SportTV 3", "SportTV 4", "SportTV 5", "SportTV 6", "Off", "A&E", "AMC", "Art 1", "AXN", 
  "Canal Brasil", "Cinemax", "HBO", "HBO 2", "HBO Family", "HBO Mundi", "HBO Plus", "HBO Pop", 
  "HBO Signature", "HBO Xtreme", "Megapix", "Paramount", "Sony Channel", "Space", "TCM", "TNT", 
  "TNT Series", "Telecine Action", "Telecine Cult", "Telecine Fun", "Telecine Pipoca", "Telecine Premium", 
  "Telecine Touch", "Universal TV", "Warner Channel", "Cartoon Network", "Cartoonito", "Discovery Kids", 
  "Disney Channel", "Disney Junior", "Gloob", "Gloobinho", "Nickelodeon", "Tooncast", "Zoomoo", "Bis", 
  "MTV", "MTV Live", "Music Box Brasil", "BandNews", "CNN Brasil", "GloboNews", "Jovem Pan News", 
